class Solution {
public:
    TreeNode* inorderSuccessor(TreeNode* root, TreeNode* p) {
        
        TreeNode* successor = NULL;

        while (root != NULL) {
            
            if (p->val < root->val) {
                // Possible successor
                successor = root;
                root = root->left;
            }
            else {
                root = root->right;
            }
        }

        return successor;
    }
};
